fn start_background_services(app: &AppHandle, port: u16) {
    server::start(app.clone(), port);
    watcher::start(app.clone());
    usage::start(app.clone());
    codex::start(app.clone());
    copilot::start(app.clone());
    antigravity::start(app.clone());
    opencode::start(app.clone());
    activity::start(app.clone());
    reset_watch::start(app.clone());

    let gh = app.clone();
    std::thread::spawn(move || reload_glyphs(&gh));

    backdrop::start(app.clone());
    fullscreen::start(app.clone());
    topmost::start_watchdog(app.clone());
    taskbar::start(app);

    // Tray menu updater
    let menu_app = app.clone();
    std::thread::spawn(move || {
        let mut last: Option<Vec<Option<i64>>> = None;
        let mut ticked = Instant::now();
        loop {
            std::thread::sleep(Duration::from_secs(2));
            let values: Vec<Option<i64>> = TRAY_PROVIDER_IDS
                .iter()
                .map(|id| ring_fraction(&menu_app, id).map(|f| (f * 1000.0).round() as i64))
                .collect();
            let changed = last.as_ref() != Some(&values);
            if !changed && ticked.elapsed() < Duration::from_secs(60) {
                continue;
            }
            if changed {
                last = Some(values);
            }
            ticked = Instant::now();
            tray::refresh_menu(&menu_app);
        }
    });

    // Work-area & system theme watcher
    let wa_app = app.clone();
    std::thread::spawn(move || {
        let mut last = core::attached_screen(&wa_app).map(|s| s.work);
        let mut last_theme = resolved_theme(&wa_app);
        loop {
            std::thread::sleep(Duration::from_secs(1));
            if DRAGGING.load(Ordering::SeqCst) {
                continue;
            }
            let sys_theme = resolved_theme(&wa_app);
            if sys_theme != last_theme {
                last_theme = sys_theme;
                wa_app.send_ui(UiEvent::ApplyTheme);
            }
            let now = core::attached_screen(&wa_app).map(|s| s.work);
            if now != last {
                last = now;
                place_notch(&wa_app);
            }
        }
    });

    // Seen-clears-it scan
    let acker = app.clone();
    std::thread::spawn(move || {
        activity::lower_thread_priority();
        loop {
            std::thread::sleep(Duration::from_millis(1500));
            if ack_scan(&acker) {
                broadcast(&acker);
            }
        }
    });

    // Stale session cleanup
    let sweeper = app.clone();
    std::thread::spawn(move || loop {
        std::thread::sleep(Duration::from_secs(30));
        let changed = sweeper.state::<AppState>().store.lock().unwrap().sweep();
        if changed {
            broadcast(&sweeper);
        }
    });
}

#[cfg(windows)]
fn ack_scan(app: &AppHandle) -> bool {
    let need = app.state::<AppState>().store.lock().unwrap().has_done();
    if !need { return false; }
    let fg = focus::fg_pid();
    if fg == 0 { return false; }
    let maps = focus::proc_maps();
    let fg_name = maps.name.get(&fg).cloned().unwrap_or_default();
    let fg_is_claude_desktop = fg_name.contains("claude") && !fg_name.contains("notcha");
    app.state::<AppState>().store.lock().unwrap().ack_done(|s| {
        if s.ppid == 0 {
            fg_is_claude_desktop
        } else {
            focus::pid_hits_chain(fg, &focus::chain_of(s.ppid, &maps.ppid), &maps)
        }
    })
}

#[cfg(not(windows))]
fn ack_scan(_app: &AppHandle) -> bool { false }

#[cfg(windows)]
fn attach_console() {
    use windows::Win32::System::Console::{AttachConsole, ATTACH_PARENT_PROCESS};
    unsafe { let _ = AttachConsole(ATTACH_PARENT_PROCESS); }
}

fn report(r: Result<String, String>) {
    let msg = match r {
        Ok(m) => format!("OK: {m}"),
        Err(e) => format!("FAILED: {e}"),
    };
    println!("{msg}");
    let log = config::config_path().with_file_name("install.log");
    let _ = std::fs::write(log, &msg);
}

#[cfg(windows)]
fn adopt_system_proxy() {
    if ["HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy"]
        .iter()
        .any(|k| std::env::var_os(k).is_some())
    {
        return;
    }
    let query = |v: &str| -> Option<String> {
        let mut c = std::process::Command::new("reg");
        c.args(["query", r"HKCU\Software\Microsoft\Windows\CurrentVersion\Internet Settings", "/v", v]);
        use std::os::windows::process::CommandExt;
        c.creation_flags(0x0800_0000);
        let out = c.output().ok()?;
        let text = String::from_utf8_lossy(&out.stdout);
        text.lines()
            .find(|l| l.trim_start().starts_with(v))
            .and_then(|l| l.split_whitespace().last().map(str::to_string))
    };
    if query("ProxyEnable").as_deref() != Some("0x1") {
        return;
    }
    let Some(server) = query("ProxyServer") else { return };
    let https = server
        .split(';')
        .find_map(|e| e.strip_prefix("https="))
        .or_else(|| if server.contains('=') { server.split(';').find_map(|e| e.strip_prefix("http=")) } else { Some(server.as_str()) });
    if let Some(h) = https {
        let url = if h.contains("://") { h.to_string() } else { format!("http://{h}") };
        unsafe {
            std::env::set_var("HTTPS_PROXY", &url);
            std::env::set_var("HTTP_PROXY", &url);
        }
    }
}

fn main() {
    #[cfg(windows)]
    adopt_system_proxy();

    let args: Vec<String> = std::env::args().collect();
    if let Some(cmd) = args.get(1) {
        if ["install-hooks", "uninstall-hooks", "doctor"].contains(&cmd.as_str()) {
            #[cfg(windows)]
            attach_console();
        }
        match cmd.as_str() {
            "install-hooks" => { report(hooks_install::install()); return; }
            "uninstall-hooks" => { report(hooks_install::uninstall()); return; }
            "doctor" => {
                let out = if args.get(2).map(|s| s.as_str()) == Some("deep") { diag::run() } else { doctor::run() };
                println!("{out}");
                let _ = std::fs::write(config::config_path().with_file_name("doctor.log"), &out);
                return;
            }
            _ => {}
        }
    }

    iced::daemon(NotchA::boot, NotchA::update, NotchA::view)
        .title(NotchA::title)
        .theme(NotchA::theme)
        .style(NotchA::style)
        .subscription(NotchA::subscription)
        .run()
        .expect("notchA failed to start");
}
